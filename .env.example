# ─────────────────────────────────────────────────────────────────────────────
# Observatorio de Datos Sanitarios de Caldas — Variables de entorno
# Copiar este archivo como .env y completar los valores
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server (Data Warehouse) ───────────────────────────────────────────────
DATABASESQL=ObservatorioDW
PASSWORDSQL=TuPassword123!

# ── PostgreSQL (Usuarios + Datos Anonimizados) ────────────────────────────────
USERNAMEPOSTGRES=observatorio
PASSWORDPOSTGRES=TuPassword456!
DATABASEPOSTGRES=observatorio_db
DATABASE_URL=postgresql://observatorio:TuPassword456!@postgres:5432/observatorio_db

# ── SQL Server connection string completa (Backend .NET) ─────────────────────
DATABASE_SQL_URL=Server=sqlserver,1433;Database=ObservatorioDW;User Id=sa;Password=TuPassword123!;TrustServerCertificate=True

# ── JWT (Backend .NET) ────────────────────────────────────────────────────────
# Genera una clave segura: openssl rand -base64 64
Jwt__Key=CAMBIA_POR_UNA_CLAVE_SECRETA_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=ObservatorioAPI
Jwt__Audience=ObservatorioAPIUsers
Jwt__ExpiresInMinutes=60
Jwt__RefreshTokenExpiresInDays=7

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
ID_CLIENTE=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── Email (notificaciones) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@gmail.com
SMTP_PASSWORD=tu_app_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=TuRedisPassword789!
REDIS_URL=redis://:TuRedisPassword789!@redis:6379

# ── Microservicio AI ──────────────────────────────────────────────────────────
AI_BASE_URL=http://ai:8001

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── OpenAI / Cohere (RAG) — completar cuando se implemente el chatbot ─────────
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AI_URL=http://localhost:8001
